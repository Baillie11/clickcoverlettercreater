RewriteEngine On

# Proxy API requests to Node.js backend on port 3050
RewriteCond %{REQUEST_URI} ^/auth/ [OR]
RewriteCond %{REQUEST_URI} ^/api/ [OR]
RewriteCond %{REQUEST_URI} ^/responses [OR]
RewriteCond %{REQUEST_URI} ^/user/ [OR]
RewriteCond %{REQUEST_URI} ^/applications [OR]
RewriteCond %{REQUEST_URI} ^/health
RewriteRule ^(.*)$ http://localhost:3050/$1 [P,L]

# Enable CORS for proxied requests
Header set Access-Control-Allow-Origin "*"
Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
Header set Access-Control-Allow-Headers "Content-Type, Authorization"
